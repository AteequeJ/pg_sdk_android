<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PGSdk" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pg_primary</item>
        <item name="colorPrimaryDark">@color/pg_primary_dark</item>
        <item name="colorOnPrimary">@color/pg_on_primary</item>
        <item name="colorPrimaryContainer">@color/pg_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pg_primary</item>
        <item name="colorSecondary">@color/pg_primary</item>
        <item name="colorSurface">@color/pg_surface</item>
        <item name="colorOnSurface">@color/pg_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/pg_text_secondary</item>
        <item name="colorOutline">@color/pg_outline</item>
        <item name="colorError">@color/pg_error</item>
        <item name="android:colorBackground">@color/pg_background</item>
        <item name="android:windowBackground">@color/pg_background</item>

        <item name="android:statusBarColor">@color/pg_background</item>
        <item name="android:navigationBarColor">@color/pg_background</item>
        <item name="android:windowLightStatusBar">@bool/pg_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/pg_light_system_bars</item>

        <item name="materialButtonStyle">@style/Widget.PGSdk.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.PGSdk.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.PGSdk.TextInputLayout</item>
    </style>

    <style name="Theme.PGSdk.Toolbar" parent="Widget.Material3.Toolbar" />

    <style name="Widget.PGSdk.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PGSdk.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/pg_outline</item>
    </style>

    <style name="Widget.PGSdk.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
    </style>

    <!-- Rounded, hairline-outlined surface used for list groups and option rows. -->
    <style name="Widget.PGSdk.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/pg_surface</item>
        <item name="strokeColor">@color/pg_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="TextAppearance.PGSdk.Section" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/pg_text_secondary</item>
    </style>

    <style name="TextAppearance.PGSdk.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pg_on_surface</item>
    </style>
</resources>
