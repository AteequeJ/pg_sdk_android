<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp"
    android:minWidth="84dp">

    <ImageView
        android:id="@+id/pgAppIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/pg_content_desc_upi_app_icon"
        android:src="@drawable/pg_ic_upi_placeholder" />

    <TextView
        android:id="@+id/pgAppLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/pg_on_surface"
        android:textSize="12sp"
        tools:text="Google Pay" />

</LinearLayout>
