<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/pg_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/pg_bg_status_circle"
            android:backgroundTint="@color/pg_error_container">

            <ImageView
                android:id="@+id/pgErrorIcon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@string/pg_content_desc_status_icon"
                android:src="@drawable/pg_ic_error" />
        </FrameLayout>

        <TextView
            android:id="@+id/pgErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/pg_error_generic_title"
            android:textColor="@color/pg_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pgErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/pg_text_secondary"
            android:textSize="14sp"
            tools:text="We could not reach the payment server. Please check your connection." />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pgErrorRetryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pg_retry" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pgErrorCancelButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pg_cancel"
        android:textColor="@color/pg_on_surface" />

</LinearLayout>
