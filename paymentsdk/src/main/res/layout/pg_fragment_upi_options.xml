<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pg_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/pgUpiAppsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/pg_upi_apps_title"
            android:textAppearance="@style/TextAppearance.PGSdk.Section" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pgUpiAppsCard"
            style="@style/Widget.PGSdk.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pgUpiAppsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:padding="8dp"
                tools:itemCount="5"
                tools:listitem="@layout/pg_item_upi_app" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/pgUpiNoAppsMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pg_bg_note"
            android:padding="14dp"
            android:text="@string/pg_upi_no_apps"
            android:textColor="@color/pg_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/pg_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/pg_upi_or_divider"
                android:textAppearance="@style/TextAppearance.PGSdk.Section"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/pg_outline" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/pg_upi_vpa_title"
            android:textAppearance="@style/TextAppearance.PGSdk.Section" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pgVpaInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pg_upi_vpa_label"
            app:boxBackgroundColor="@color/pg_surface"
            app:startIconDrawable="@drawable/pg_ic_upi"
            app:startIconTint="@color/pg_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pgVpaInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pgVpaSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pg_upi_vpa_submit" />

    </LinearLayout>
</ScrollView>
