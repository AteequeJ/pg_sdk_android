<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/pg_background">

    <ImageView
        android:id="@+id/pgResultIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/pg_content_desc_status_icon"
        tools:src="@drawable/pg_ic_success" />

    <TextView
        android:id="@+id/pgResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/pg_on_surface"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="@string/pg_result_success_title" />

    <TextView
        android:id="@+id/pgResultMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/pg_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Your payment reference is PAY123456" />

</LinearLayout>
