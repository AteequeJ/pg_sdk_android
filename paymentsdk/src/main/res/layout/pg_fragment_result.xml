<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/pg_background">

    <FrameLayout
        android:id="@+id/pgResultIconContainer"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/pg_bg_status_circle"
        tools:backgroundTint="@color/pg_success_container">

        <ImageView
            android:id="@+id/pgResultIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:contentDescription="@string/pg_content_desc_status_icon"
            tools:src="@drawable/pg_ic_success" />
    </FrameLayout>

    <TextView
        android:id="@+id/pgResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textColor="@color/pg_on_surface"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="@string/pg_result_success_title" />

    <TextView
        android:id="@+id/pgResultMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/pg_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Your payment reference is PAY123456"
        tools:visibility="visible" />

</LinearLayout>
